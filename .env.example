# Copy this file to .env and change values as needed.
TCP_HOST=0.0.0.0
TCP_PORT=5000
MAX_PACKET_BYTES=262144
IDLE_TIMEOUT_MS=120000

# HTTP dashboard and REST API.
WEB_HOST=0.0.0.0
WEB_PORT=3000
# Meter communication status: online while the last valid packet is at most
# METER_ONLINE_AFTER_S old, delayed until METER_OFFLINE_AFTER_S, then offline.
METER_ONLINE_AFTER_S=600
METER_OFFLINE_AFTER_S=1800
# Time zone for dashboard timestamps and the start of "today".
DISPLAY_TIMEZONE=Asia/Kolkata

# MySQL account must be allowed to create DB_NAME on first startup.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=amr_tcp_server
# Separate pools: packet ingestion and the dashboard.
DB_CONNECTION_LIMIT=10
DB_WEB_CONNECTION_LIMIT=4
